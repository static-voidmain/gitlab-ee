# 이 파일을 .env로 복사한 뒤 운영 환경 값으로 수정한다.
# 민감정보는 Git 저장소에 커밋하지 않는다.

COMPOSE_PROJECT_NAME=gitlab-ee

# GitLab EE 2026-05-21 최신 안정 릴리스. 운영 반영 전 19.0 breaking change 검토가 필요하다.
GITLAB_IMAGE=gitlab/gitlab-ee:19.0.0-ee.0
GITLAB_CONTAINER_NAME=gitlab-ee
GITLAB_HOSTNAME=gitlab.example.co.kr
GITLAB_EXTERNAL_URL=https://gitlab.example.co.kr
GITLAB_HTTP_BIND=127.0.0.1
GITLAB_HTTP_PORT=8080
GITLAB_HOME=/srv/gitlab-ee
GITLAB_TIMEZONE=Asia/Seoul
GITLAB_BACKUP_KEEP_SECONDS=1209600
GITLAB_LOG_ROTATE_SIZE=200000000
GITLAB_LOG_ROTATE_NUM=30

# 외부 Nginx, LB, 보안장비 CIDR만 입력한다. 절대 0.0.0.0/0 사용 금지.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Git/Registry HTTP 인증 실패 IP 차단. 정상 요청의 최초 401을 오탐하는 외부 Fail2Ban 규칙 대신 GitLab 내장 기능을 사용한다.
GIT_BASIC_AUTH_BAN_ENABLED=true
GIT_BASIC_AUTH_BAN_IP_WHITELIST=127.0.0.1
GIT_BASIC_AUTH_BAN_MAX_RETRY=5
GIT_BASIC_AUTH_BAN_FIND_TIME_SECONDS=60
GIT_BASIC_AUTH_BAN_TIME_SECONDS=3600

# GitLab Docs self-hosting.
GITLAB_DOCS_IMAGE=registry.gitlab.com/gitlab-org/technical-writing/docs-gitlab-com/archives:19.0
GITLAB_DOCS_CONTAINER_NAME=gitlab-docs
GITLAB_DOCS_HOSTNAME=gitlab-docs.example.co.kr
GITLAB_DOCS_EXTERNAL_URL=https://gitlab-docs.example.co.kr
GITLAB_DOCS_BIND=127.0.0.1
GITLAB_DOCS_PORT=4000

# SMTP는 사내 릴레이가 준비된 경우에만 true로 변경한다.
SMTP_ENABLE=false
SMTP_ADDRESS=smtp.example.co.kr
SMTP_PORT=587
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_DOMAIN=example.co.kr
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
GITLAB_EMAIL_FROM=gitlab@example.co.kr
GITLAB_EMAIL_REPLY_TO=gitlab@example.co.kr

# GitLab Runner.
GITLAB_RUNNER_IMAGE=gitlab/gitlab-runner:alpine-v19.0.0
GITLAB_SHELL_RUNNER_IMAGE=registry.example.co.kr/scm-runners/gitlab-runner-shell:19.0.0
GITLAB_RUNNER_DOCKER_CONTAINER_NAME=gitlab-runner-docker
GITLAB_RUNNER_SHELL_CONTAINER_NAME=gitlab-runner-shell
RUNNER_DOCKER_CONFIG_HOME=./runtime/gitlab-runner/docker
RUNNER_SHELL_CONFIG_HOME=./runtime/gitlab-runner/shell
RUNNER_SHELL_BUILDS_HOME=./runtime/gitlab-runner/shell-builds
RUNNER_CACHE_HOME=./runtime/gitlab-runner/cache

# GitLab UI/API에서 Runner를 먼저 만들고 glrt- 토큰을 입력한다.
RUNNER_DOCKER_AUTH_TOKEN=glrt-replace-with-docker-runner-token
RUNNER_SHELL_AUTH_TOKEN=glrt-replace-with-shell-runner-token
RUNNER_DOCKER_DESCRIPTION=gitlab-ee-docker-amd64
RUNNER_SHELL_DESCRIPTION=gitlab-ee-shell-coderay-amd64

# CodeRay CLI는 사내 배포본 경로를 read-only mount한다.
CODERAY_CLI_DIR=/opt/coderay6rg

# Nexus 업로드용 CI 변수 예시. 실제 값은 GitLab masked/protected CI variables 권장.
NEXUS_URL=https://nexus.example.co.kr
NEXUS_DEV_REPOSITORY=maven-dev
NEXUS_STG_REPOSITORY=maven-stg
NEXUS_PRD_REPOSITORY=maven-prd

# Docker Scout quickview와 Critical/High CVE 상세 보고서 저장 경로.
# 운영 registry의 배포 후보를 검사할 때는 SCOUT_IMAGE_PREFIX=registry:// 로 변경한다.
SCOUT_IMAGE_PREFIX=image://
SCOUT_REPORT_DIR=./reports/docker-scout

# 이미지 빌드/푸시 대상 registry.
INTERNAL_IMAGE_REGISTRY=registry.example.co.kr/scm-runners
